---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout>
	<div class="content">
		<h2>Welcome to the Lit Directory!</h2>
		<p>Explore a curated collection of books and literary works from various genres and authors. Whether you're a casual reader or a literature enthusiast, you'll find something to pique your interest.</p>
		<a href="/books">View Books</a>
	</div>
</BaseLayout>

<style>
	.content{
		text-align: center;
	}
	a {
		display: inline-block;
		background-color: #750eeb;
		color: #fff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}
	a:hover {
		background-color: #965ee9;
	}
</style>
