---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout>
	<div class="content">
		<h2>Welcome to the Lit Directory!</h2>
		<p>Explore a curated collection of book reviews and literary critiques across various genres and styles. 
			Whether you're deciding on your next read or looking for deep dives into classic and modern stories, 
			you'll find fresh perspectives to spark your curiosity.</p>
		<a href="/books">View Books</a>
	</div>
</BaseLayout>

<style>
	.content{
		text-align: center;
	}
	a {
		display: inline-block;
		background-color: #750eeb;
		color: #fff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}
	a:hover {
		background-color: #965ee9;
	}
</style>
