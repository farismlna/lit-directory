---
import type { CollectionEntry } from 'astro:content';

interface Props {
	book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
---

<div class="book-card">
	<div class="book-header">
		<h3 class="book-title">{book.data.title} ({book.data.year})</h3>
		<p class="book-rating">{book.data.rating}/10</p>
	</div>
    <p class="book-author"> {book.data.author}</p>
    <p class="book-genre"><strong>Genre:</strong> {book.data.genre}</p>
    <p class="book-summary">{book.data.summary}</p>
	<a href={`/books/${book.id}`}>Read Review</a>
</div>

<style>
	h2 {
		padding-right: 10px;
		border-right: 8px solid #750eeb;
		border-bottom: 8px solid #750eeb;
		margin-bottom: 40px;
		text-align: right;
	}
	.book-card {
		background-color: #f9f6fc;
		padding: 16px 20px;
		margin: 20px auto;
		box-shadow: 8px 8px 0 #ebe5f2;
	}
	.book-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.book-title {
		font-size: 1.4em;
		font-weight: bold;
		margin: 0;
	}
	.book-rating {
		font-weight: bold;
		color: #750eeb;
		font-size: 1.5em;
		margin: 0;
	}
	.book-author {
		margin-top: 0;
	}

    a {
        display: inline-block;
        background-color: #750eeb;
        color: #fff;
        padding: 6px 10px;
        border-radius: 2px;
        text-decoration: none;
    }
    a:hover {
        background-color: #965ee9;
    }
</style>